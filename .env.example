# Repo-root .env for docker compose — copy to `.env` on the target machine
# and fill in the values.  docker-compose.yml / docker-compose.internal.yml
# read these via `${...}` substitution at startup.

# --- Anthropic API key for the crawler agent's Claude pipeline -------------
# Required for --use-llm extraction (text + vision). Get one at
# https://console.anthropic.com/  (Settings -> API Keys).
ANTHROPIC_API_KEY=

# --- Quiz app admin credentials --------------------------------------------
# Used by the internal agent's `push` step to authenticate to the GUI's
# /admin/questions/import endpoint. Default admin is created on first boot:
# admin@local / ChangeMe123!  (no password change required for this account).
QUIZ_APP_ADMIN_EMAIL=admin@local
QUIZ_APP_ADMIN_PASSWORD=ChangeMe123!

# --- Optional: Google Drive source (uncomment + fill if you want it) -------
# To use the Drive source you also need to:
#   1. Put a service-account JSON at ./google-sa.json
#   2. Share the Drive folder with the SA's email
#   3. Uncomment the SA bind-mount in docker-compose.internal.yml
# GOOGLE_DRIVE_FOLDER_ID=
