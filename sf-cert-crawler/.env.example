# ===========================================================================
# Shared
# ===========================================================================

# Anthropic Claude API key — used by the LLM classify/extract pipeline (both
# the external web agent with --use-llm and the internal agent with --use-llm).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown):
# DEFAULT_RATE_PER_SEC=1.0
# REQUEST_TIMEOUT_S=20
# MAX_RETRIES=4

# Quality gate: minimum extractor confidence for a question to be eligible to
# push to the quiz app.
# QUALITY_MIN_CONFIDENCE=0.5

# ===========================================================================
# Quiz app  ("Salesforce Admin Practice playground" — the Spring app in ../)
# ===========================================================================
# `push` posts ready questions here; they land as PENDING and you approve them
# in the quiz app's admin UI. Use the admin's CURRENT password (not the initial
# ChangeMe123! — that one triggers the force-change filter and the import will
# be redirected).
QUIZ_APP_URL=http://localhost:8095
QUIZ_APP_ADMIN_EMAIL=admin@local
QUIZ_APP_ADMIN_PASSWORD=

# ===========================================================================
# Internal agent only
# ===========================================================================

# Google Drive source: provide ONE of the two credential files (absolute paths;
# inside Docker these are mounted into the container).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
# The Drive folder to read (just the folder id from the folder's URL, e.g.
# https://drive.google.com/drive/folders/<THIS_PART>).
GOOGLE_DRIVE_FOLDER_ID=

# Local-folder source: a directory of .txt / .md / .html / .pdf study material.
LOCAL_SOURCE_DIR=

# Note: Reddit and Trailhead were removed as sources (robots.txt / ToU). The
# internal agent reads ONLY from Google Drive and the local folder above; it
# does no web crawling.
